# Copy to .env and fill in. Never commit .env.

# --- Claude -------------------------------------------------------------------
# Optional: enables "Ask the agent" and AI report drafts. Everything else works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Kill switch --------------------------------------------------------------
# false = every model call is refused (fails closed). The engines keep working.
AI_ENABLED=true
# Set to enable the runtime kill switch on /governance (header X-Admin-Token).
# Leave empty to lock it; AI_ENABLED=false always works.
ADMIN_TOKEN=

# --- Human review gate ----------------------------------------------------------
# Optional: if set, every approve / edit / reject must send header X-Reviewer-Token.
REVIEWER_TOKEN=

# --- Limiter ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=5        # AI requests per visitor per minute
DAILY_CAP_PER_VISITOR=25       # AI requests per visitor per UTC day
DAILY_CAP_GLOBAL=200           # AI requests, all visitors, per UTC day
DAILY_TOKEN_BUDGET=400000      # input + output tokens, all visitors, per UTC day
MAX_TOKENS=1024                # max_tokens per agent model call
NARRATIVE_MAX_TOKENS=400       # max_tokens for a report-summary draft
MAX_AGENT_TURNS=6              # tool round trips per question
MAX_REQUEST_BYTES=16384        # largest request body accepted (413 above this)
MAX_QUESTION_CHARS=1000        # longest question accepted (422 above this)
# 0 = use the direct client address; 1 = behind one proxy (Render)
TRUSTED_PROXY_HOPS=0
# Salt for hashing visitor addresses (raw IPs are never stored). Change it in production.
VISITOR_SALT=change-me

# --- Integrations ---------------------------------------------------------------
# Optional: approved Slack digests are posted here; otherwise approvals run as a dry run.
SLACK_WEBHOOK_URL=
